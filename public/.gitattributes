# AgentPlat packages this default favicon directly from source without LFS hydration.
favicon.png -filter -diff -merge -text

# Files the browser loads directly must be real blobs, not LFS pointers: Vercel and the Figma Make
# packager do not hydrate LFS, so a pointer would be served instead of the image or sound.
assets/characters/portraits/** -filter -diff -merge -text
audio/** -filter -diff -merge -text
assets/hero/** -filter -diff -merge -text
assets/characters/full/** -filter -diff -merge -text
assets/art/** -filter -diff -merge -text
assets/icons/** -filter -diff -merge -text
assets/scenes/** -filter -diff -merge -text

# Brand logo is loaded directly by the browser (header badge).
logo/** -filter -diff -merge -text
